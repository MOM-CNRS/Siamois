<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!--
        Indexes backing the count-based ORDER BY specifications added for the sortable
        "relations"/"mobilier"/"actions"/"UE" table columns (RecordingUnitSpec, ActionUnitSpec,
        SpatialUnitSpec). Postgres does not auto-index FK columns, only the referenced PK side.
    -->

    <changeSet id="2026.08.27-0" author="Grégory Bliault" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="specimen" indexName="idx_specimen_fk_recording_unit_id"/>
            </not>
        </preConditions>
        <createIndex tableName="specimen" indexName="idx_specimen_fk_recording_unit_id">
            <column name="fk_recording_unit_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026.08.27-1" author="Grégory Bliault" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="stratigraphic_relationship" indexName="idx_stratrel_fk_recording_unit_1_id"/>
            </not>
        </preConditions>
        <createIndex tableName="stratigraphic_relationship" indexName="idx_stratrel_fk_recording_unit_1_id">
            <column name="fk_recording_unit_1_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026.08.27-2" author="Grégory Bliault" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="stratigraphic_relationship" indexName="idx_stratrel_fk_recording_unit_2_id"/>
