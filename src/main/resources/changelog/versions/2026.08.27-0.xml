        </preConditions>
        <createIndex tableName="stratigraphic_relationship" indexName="idx_stratrel_fk_recording_unit_2_id">
            <column name="fk_recording_unit_2_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026.08.27-3" author="Grégory Bliault" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="recording_unit" indexName="idx_ru_fk_spatial_unit_id"/>
            </not>
        </preConditions>
        <createIndex tableName="recording_unit" indexName="idx_ru_fk_spatial_unit_id">
            <column name="fk_spatial_unit_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026.08.27-4" author="Grégory Bliault" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="action_unit_spatial_context" indexName="idx_auspatctx_fk_action_unit_id"/>
            </not>
        </preConditions>
        <createIndex tableName="action_unit_spatial_context" indexName="idx_auspatctx_fk_action_unit_id">
            <column name="fk_action_unit_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026.08.27-5" author="Grégory Bliault" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="action_unit_spatial_context" indexName="idx_auspatctx_fk_spatial_unit_id"/>
            </not>
        </preConditions>
        <createIndex tableName="action_unit_spatial_context" indexName="idx_auspatctx_fk_spatial_unit_id">
            <column name="fk_spatial_unit_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
