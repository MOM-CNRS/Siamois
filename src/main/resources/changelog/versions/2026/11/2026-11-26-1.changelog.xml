        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-container-relation-link-delete-trigger" author="Gregory Bliault">
        <sql>
            DROP TRIGGER IF EXISTS trg_relation_link_delete ON public.container;
            CREATE TRIGGER trg_relation_link_delete
                AFTER DELETE ON public.container
                FOR EACH ROW EXECUTE FUNCTION public.relation_link_delete_on_entity_delete('CONTAINER', 'container_id');
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-siamois-document-relation-link-delete-trigger" author="Gregory Bliault">
        <sql>
            DROP TRIGGER IF EXISTS trg_relation_link_delete ON public.siamois_document;
            CREATE TRIGGER trg_relation_link_delete
                AFTER DELETE ON public.siamois_document
