<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!--
    Configurable relations between records (docs/modele-relations.md), first step: the tables only, with no data.
    relation_definition holds the identity of a relation and is global; relation_rule and its three tables hold its
    rules per scope (platform default, institution, project), as the configuration of the fiches does;
    relation_link holds the links, each end being a record kind and its id. The business tables do not change.
    -->


    <!-- The identity of a relation, global: its two fields (the same one when symmetric) and what fixes the meaning of its links. -->
    <changeSet id="2026-11-26-1-relation-definition-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_definition">
            <column name="relation_definition_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="relation_definition_pkey"/>
            </column>
            <column name="fk_source_field_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_definition_source_field"
                             references="public.custom_field(custom_field_id)"/>
            </column>
            <column name="fk_target_field_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_definition_target_field"
                             references="public.custom_field(custom_field_id)"/>
            </column>
            <column name="kind" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="is_symmetric" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_hierarchical" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="fk_qualifier_field_id" type="bigint">
                <constraints foreignKeyName="fk_relation_definition_qualifier_field"
                             references="public.custom_field(custom_field_id)"/>
            </column>
        </createTable>
    </changeSet>


    <!-- A symmetric relation uses one field for both sides, and only a complex relation has a qualifier. -->
    <changeSet id="2026-11-26-1-relation-definition-checks" author="Gregory Bliault">
        <sql>
            ALTER TABLE public.relation_definition
                ADD CONSTRAINT ck_relation_definition_kind CHECK (kind IN ('SIMPLE', 'COMPLEX')),
                ADD CONSTRAINT ck_relation_definition_symmetric_fields
                    CHECK (is_symmetric = (fk_source_field_id = fk_target_field_id)),
                ADD CONSTRAINT ck_relation_definition_symmetric_not_hierarchical CHECK (NOT (is_symmetric AND is_hierarchical)),
                ADD CONSTRAINT ck_relation_definition_qualifier_complex
                    CHECK (fk_qualifier_field_id IS NULL OR kind = 'COMPLEX');
        </sql>
    </changeSet>


    <!-- A field belongs to one definition only (whether it is also the other side of another one is checked by the service). -->
    <changeSet id="2026-11-26-1-relation-definition-unique-source-field" author="Gregory Bliault">
        <addUniqueConstraint schemaName="public" tableName="relation_definition" columnNames="fk_source_field_id"
                             constraintName="uk_relation_definition_source_field"/>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-definition-unique-target-field" author="Gregory Bliault">
        <addUniqueConstraint schemaName="public" tableName="relation_definition" columnNames="fk_target_field_id"
                             constraintName="uk_relation_definition_target_field"/>
    </changeSet>


    <!-- The rules of a relation, per scope: the platform default (no institution, no project), an institution
    (no project) or a project. A link obeys the rules of its project, else of its institution, else the platform default. -->
    <changeSet id="2026-11-26-1-relation-rule-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_rule">
            <column name="relation_rule_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="relation_rule_pkey"/>
            </column>
            <column name="fk_relation_definition_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_rule_definition"
                             references="public.relation_definition(relation_definition_id)" deleteCascade="true"/>
            </column>
            <column name="fk_institution_id" type="bigint">
                <constraints foreignKeyName="fk_relation_rule_institution"
                             references="public.institution(institution_id)" deleteCascade="true"/>
            </column>
            <column name="fk_action_unit_id" type="bigint">
                <constraints foreignKeyName="fk_relation_rule_action_unit"
                             references="public.action_unit(action_unit_id)" deleteCascade="true"/>
            </column>
            <column name="no_cycle" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="source_unique" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="target_unique" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-scope-check" author="Gregory Bliault">
        <sql>
            ALTER TABLE public.relation_rule
                ADD CONSTRAINT ck_relation_rule_project_has_institution
                    CHECK (fk_action_unit_id IS NULL OR fk_institution_id IS NOT NULL);
        </sql>
    </changeSet>


    <!-- One rule set per definition and scope. Partial indexes, since a unique constraint never compares NULLs. -->
    <changeSet id="2026-11-26-1-relation-rule-unique-platform" author="Gregory Bliault">
        <sql>
            CREATE UNIQUE INDEX uk_relation_rule_platform ON public.relation_rule (fk_relation_definition_id)
                WHERE fk_institution_id IS NULL;
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-unique-institution" author="Gregory Bliault">
        <sql>
            CREATE UNIQUE INDEX uk_relation_rule_institution
                ON public.relation_rule (fk_relation_definition_id, fk_institution_id)
                WHERE fk_institution_id IS NOT NULL AND fk_action_unit_id IS NULL;
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-unique-project" author="Gregory Bliault">
        <sql>
            CREATE UNIQUE INDEX uk_relation_rule_project
                ON public.relation_rule (fk_relation_definition_id, fk_action_unit_id)
                WHERE fk_action_unit_id IS NOT NULL;
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-aud-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_rule_aud">
            <column name="relation_rule_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="rev" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="revtype" type="smallint"/>
            <column name="fk_relation_definition_id" type="bigint"/>
            <column name="fk_relation_definition_id_mod" type="boolean"/>
            <column name="fk_institution_id" type="bigint"/>
            <column name="fk_institution_id_mod" type="boolean"/>
            <column name="fk_action_unit_id" type="bigint"/>
            <column name="fk_action_unit_id_mod" type="boolean"/>
            <column name="no_cycle" type="boolean"/>
            <column name="no_cycle_mod" type="boolean"/>
            <column name="source_unique" type="boolean"/>
            <column name="source_unique_mod" type="boolean"/>
            <column name="target_unique" type="boolean"/>
            <column name="target_unique_mod" type="boolean"/>
        </createTable>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-aud-primary-key" author="Gregory Bliault">
        <addPrimaryKey schemaName="public" tableName="relation_rule_aud" columnNames="rev, relation_rule_id"
                       constraintName="relation_rule_aud_pkey"/>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-aud-revinfo" author="Gregory Bliault">
        <addForeignKeyConstraint baseTableSchemaName="public" baseTableName="relation_rule_aud" baseColumnNames="rev"
                                 constraintName="fk_relation_rule_aud_revinfo"
                                 referencedTableSchemaName="public" referencedTableName="revinfo"
                                 referencedColumnNames="rev_id"/>
    </changeSet>


    <!-- The kinds of record a side accepts, with an optional subtype (a recording unit of type US). No row on a side: any record. -->
    <changeSet id="2026-11-26-1-relation-rule-kind-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_rule_kind">
            <column name="relation_rule_kind_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="relation_rule_kind_pkey"/>
            </column>
            <column name="fk_relation_rule_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_rule_kind_rule"
                             references="public.relation_rule(relation_rule_id)" deleteCascade="true"/>
            </column>
            <column name="side" type="varchar(8)">
                <constraints nullable="false"/>
            </column>
            <column name="kind" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="fk_subtype_concept_id" type="bigint">
                <constraints foreignKeyName="fk_relation_rule_kind_subtype"
                             references="public.concept(concept_id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-kind-side-check" author="Gregory Bliault">
        <sql>
            ALTER TABLE public.relation_rule_kind
                ADD CONSTRAINT ck_relation_rule_kind_side CHECK (side IN ('SOURCE', 'TARGET'));
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-kind-unique" author="Gregory Bliault">
        <sql>
            CREATE UNIQUE INDEX uk_relation_rule_kind
                ON public.relation_rule_kind (fk_relation_rule_id, side, kind, COALESCE(fk_subtype_concept_id, 0));
        </sql>
    </changeSet>


    <!-- Which qualifier concept is the mirror of which (recouvre / est recouverte par). Only the qualifier is stored on a
    link; without a pair, the mirror is the same concept. A pair is one to one, so it reads both ways. -->
    <changeSet id="2026-11-26-1-relation-rule-mirror-concept-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_rule_mirror_concept">
            <column name="relation_rule_mirror_concept_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="relation_rule_mirror_concept_pkey"/>
            </column>
            <column name="fk_relation_rule_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_rule_mirror_concept_rule"
                             references="public.relation_rule(relation_rule_id)" deleteCascade="true"/>
            </column>
            <column name="fk_concept_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_rule_mirror_concept_concept"
                             references="public.concept(concept_id)"/>
            </column>
            <column name="fk_mirror_concept_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_rule_mirror_concept_mirror"
                             references="public.concept(concept_id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-mirror-concept-unique-concept" author="Gregory Bliault">
        <addUniqueConstraint schemaName="public" tableName="relation_rule_mirror_concept"
                             columnNames="fk_relation_rule_id, fk_concept_id"
                             constraintName="uk_relation_rule_mirror_concept_concept"/>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-mirror-concept-unique-mirror" author="Gregory Bliault">
        <addUniqueConstraint schemaName="public" tableName="relation_rule_mirror_concept"
                             columnNames="fk_relation_rule_id, fk_mirror_concept_id"
                             constraintName="uk_relation_rule_mirror_concept_mirror"/>
    </changeSet>


    <!-- The definitions that cannot link the same pair as this one (order and synchrony). -->
    <changeSet id="2026-11-26-1-relation-rule-exclusion-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_rule_exclusion">
            <column name="relation_rule_exclusion_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="relation_rule_exclusion_pkey"/>
            </column>
            <column name="fk_relation_rule_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_rule_exclusion_rule"
                             references="public.relation_rule(relation_rule_id)" deleteCascade="true"/>
            </column>
            <column name="fk_excluded_definition_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_rule_exclusion_definition"
                             references="public.relation_definition(relation_definition_id)" deleteCascade="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-rule-exclusion-unique" author="Gregory Bliault">
        <addUniqueConstraint schemaName="public" tableName="relation_rule_exclusion"
                             columnNames="fk_relation_rule_id, fk_excluded_definition_id"
                             constraintName="uk_relation_rule_exclusion"/>
    </changeSet>


    <!-- A link between two records, stored once. Each end is a record kind and its id, with no foreign key: the service
    checks the record exists and a trigger on each business table removes the links of a deleted record.
    Both records belong to the same project, which the link keeps: it tells which rule set the link obeys.
    simple copies the definition's kind, so that a partial index can keep simple links unique. -->
    <changeSet id="2026-11-26-1-relation-link-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_link">
            <column name="relation_link_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" primaryKeyName="relation_link_pkey"/>
            </column>
            <column name="fk_relation_definition_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_link_definition"
                             references="public.relation_definition(relation_definition_id)"/>
            </column>
            <column name="fk_action_unit_id" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_relation_link_action_unit"
                             references="public.action_unit(action_unit_id)" deleteCascade="true"/>
            </column>
            <column name="source_kind" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="target_kind" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="target_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="fk_qualifier_concept_id" type="bigint">
                <constraints foreignKeyName="fk_relation_link_qualifier"
                             references="public.concept(concept_id)"/>
            </column>
            <column name="uncertain" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="simple" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-link-not-self-check" author="Gregory Bliault">
        <sql>
            ALTER TABLE public.relation_link
                ADD CONSTRAINT ck_relation_link_not_self CHECK (NOT (source_kind = target_kind AND source_id = target_id));
        </sql>
    </changeSet>


    <!-- Led by the record, so the same index serves the delete trigger (all the links of a record) and the reads and
    cycle check of one definition (its links from a record). -->
    <changeSet id="2026-11-26-1-relation-link-source-index" author="Gregory Bliault">
        <createIndex schemaName="public" tableName="relation_link" indexName="idx_relation_link_source">
            <column name="source_kind"/>
            <column name="source_id"/>
            <column name="fk_relation_definition_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-link-target-index" author="Gregory Bliault">
        <createIndex schemaName="public" tableName="relation_link" indexName="idx_relation_link_target">
            <column name="target_kind"/>
            <column name="target_id"/>
            <column name="fk_relation_definition_id"/>
        </createIndex>
    </changeSet>


    <!-- No duplicate simple link in a definition, even between two concurrent writes. A symmetric pair is ordered before it
    is stored, so this also catches the reversed duplicate. A complex relation may link the same pair several times. -->
    <!-- The links of a project for one definition: what checking a rule set against its existing links reads. -->
    <changeSet id="2026-11-26-1-relation-link-project-index" author="Gregory Bliault">
        <createIndex schemaName="public" tableName="relation_link" indexName="idx_relation_link_action_unit">
            <column name="fk_action_unit_id"/>
            <column name="fk_relation_definition_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-link-unique-simple" author="Gregory Bliault">
        <sql>
            CREATE UNIQUE INDEX uk_relation_link_simple
                ON public.relation_link (fk_relation_definition_id, source_kind, source_id, target_kind, target_id)
                WHERE simple;
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-link-aud-table" author="Gregory Bliault">
        <createTable schemaName="public" tableName="relation_link_aud">
            <column name="relation_link_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="rev" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="revtype" type="smallint"/>
            <column name="fk_relation_definition_id" type="bigint"/>
            <column name="fk_relation_definition_id_mod" type="boolean"/>
            <column name="fk_action_unit_id" type="bigint"/>
            <column name="fk_action_unit_id_mod" type="boolean"/>
            <column name="source_kind" type="varchar(32)"/>
            <column name="source_kind_mod" type="boolean"/>
            <column name="source_id" type="bigint"/>
            <column name="source_id_mod" type="boolean"/>
            <column name="target_kind" type="varchar(32)"/>
            <column name="target_kind_mod" type="boolean"/>
            <column name="target_id" type="bigint"/>
            <column name="target_id_mod" type="boolean"/>
            <column name="fk_qualifier_concept_id" type="bigint"/>
            <column name="fk_qualifier_concept_id_mod" type="boolean"/>
            <column name="uncertain" type="boolean"/>
            <column name="uncertain_mod" type="boolean"/>
            <column name="simple" type="boolean"/>
            <column name="simple_mod" type="boolean"/>
        </createTable>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-link-aud-primary-key" author="Gregory Bliault">
        <addPrimaryKey schemaName="public" tableName="relation_link_aud" columnNames="rev, relation_link_id"
                       constraintName="relation_link_aud_pkey"/>
    </changeSet>

    <changeSet id="2026-11-26-1-relation-link-aud-revinfo" author="Gregory Bliault">
        <addForeignKeyConstraint baseTableSchemaName="public" baseTableName="relation_link_aud" baseColumnNames="rev"
                                 constraintName="fk_relation_link_aud_revinfo"
                                 referencedTableSchemaName="public" referencedTableName="revinfo"
                                 referencedColumnNames="rev_id"/>
    </changeSet>


    <!-- The links of a deleted record go with it, for each business table. The function is in
    changelog/pgplsql/relation_link_delete_on_entity_delete.sql; the triggers are set here, once the tables exist. -->
    <changeSet id="2026-11-26-1-action-unit-relation-link-delete-trigger" author="Gregory Bliault">
        <sql>
            DROP TRIGGER IF EXISTS trg_relation_link_delete ON public.action_unit;
            CREATE TRIGGER trg_relation_link_delete
                AFTER DELETE ON public.action_unit
                FOR EACH ROW EXECUTE FUNCTION public.relation_link_delete_on_entity_delete('ACTION_UNIT', 'action_unit_id');
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-recording-unit-relation-link-delete-trigger" author="Gregory Bliault">
        <sql>
            DROP TRIGGER IF EXISTS trg_relation_link_delete ON public.recording_unit;
            CREATE TRIGGER trg_relation_link_delete
                AFTER DELETE ON public.recording_unit
                FOR EACH ROW EXECUTE FUNCTION public.relation_link_delete_on_entity_delete('RECORDING_UNIT', 'recording_unit_id');
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-specimen-relation-link-delete-trigger" author="Gregory Bliault">
        <sql>
            DROP TRIGGER IF EXISTS trg_relation_link_delete ON public.specimen;
            CREATE TRIGGER trg_relation_link_delete
                AFTER DELETE ON public.specimen
                FOR EACH ROW EXECUTE FUNCTION public.relation_link_delete_on_entity_delete('SPECIMEN', 'specimen_id');
        </sql>
    </changeSet>

    <changeSet id="2026-11-26-1-phase-relation-link-delete-trigger" author="Gregory Bliault">
        <sql>
            DROP TRIGGER IF EXISTS trg_relation_link_delete ON public.phase;
            CREATE TRIGGER trg_relation_link_delete
                AFTER DELETE ON public.phase
