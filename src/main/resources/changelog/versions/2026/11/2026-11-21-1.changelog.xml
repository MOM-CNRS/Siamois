<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="2026-11-21-1-document-import-item-identifier" author="Firas Gabsi">
        <addColumn schemaName="public" tableName="document_import_item">
            <column name="identifier" type="varchar(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-11-21-1-document-import-item-type" author="Firas Gabsi">
        <addColumn schemaName="public" tableName="document_import_item">
            <column name="fk_type_concept_id" type="bigint">
                <constraints foreignKeyName="fk_document_import_item_type" references="public.concept(concept_id)"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>