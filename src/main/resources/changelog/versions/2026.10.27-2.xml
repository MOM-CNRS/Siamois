<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!--
    The concept of a field (custom_field.fk_concept) is only the concept documenting it. An additional measurement
    field kept what it measures (SIAMD.TYPE) there: it moves to its own column, fk_measurement_type, and the field is
    left undocumented until its candidate is found in the thesaurus. Liquibase runs before Hibernate adds the column:
    it is added here. A system measurement field keeps its concept, which documents it.
    On a fresh database custom_field does not exist yet: every statement is guarded.
    -->

    <changeSet id="2026.10.27-2" author="Julien Linget">
        <sql splitStatements="false">
            DO $$
            BEGIN
                IF to_regclass('public.custom_field') IS NULL THEN
                    RETURN;
                END IF;

                ALTER TABLE custom_field ADD COLUMN IF NOT EXISTS fk_measurement_type bigint;

                UPDATE custom_field
                SET fk_measurement_type = fk_concept,
                    fk_concept = NULL
                WHERE answer_type = 'MEASUREMENT'
                  AND is_system_field IS NOT TRUE
                  AND fk_concept IS NOT NULL
                  AND fk_measurement_type IS NULL;
            END $$;
        </sql>
    </changeSet>
</databaseChangeLog>
