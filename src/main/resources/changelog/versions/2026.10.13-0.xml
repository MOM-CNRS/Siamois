<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!-- Single-use tokens sent by e-mail to reset a password or confirm a new e-mail address. -->
    <changeSet id="2026.10.13-0-person-action-token" author="Gregory Bliault">
        <preConditions onFail="MARK_RAN">
            <!-- On a fresh database "person" does not exist yet: Hibernate's ddl-auto creates everything. -->
            <tableExists tableName="person"/>
            <not>
                <tableExists tableName="person_action_token"/>
            </not>
        </preConditions>
        <createTable tableName="person_action_token">
            <column name="person_action_token_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="fk_person_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_person_action_token_person"
                             references="person(person_id)" deleteCascade="true"/>
            </column>
            <column name="action_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="new_email" type="VARCHAR(255)"/>
            <column name="creation_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="expiration_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
