<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!--
    There is at most one fiche configuration per organisation, record type, project and sub-type
    (no project / no sub-type being a value of its own): a partial-expression unique index, which JPA can't declare.
    On a fresh database the table does not exist yet when this runs: the statement is guarded.
    -->

    <changeSet id="2026.10.20-1-fiche-config-unique" author="Gregory Bliault" dbms="postgresql">
        <sql splitStatements="false">
            DO $$
            BEGIN
                IF to_regclass('fiche_config') IS NULL THEN
                    RETURN;
                END IF;
                CREATE UNIQUE INDEX IF NOT EXISTS ux_fiche_config
                    ON fiche_config (fk_institution, resource_type, COALESCE(fk_project, 0), COALESCE(type_id, 0));
            END
            $$;
        </sql>
    </changeSet>
</databaseChangeLog>
