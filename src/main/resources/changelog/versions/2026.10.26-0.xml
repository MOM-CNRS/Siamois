<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <!--
    A field on a branch or a collection remembers its label: the ids belong to one thesaurus, the name is what finds
    the same branch or collection in the thesaurus the field is moved to. Not audited, so the audit table is left alone.
    -->

    <changeSet id="2026.10.26-0-field-source-names" author="Gregory Bliault" dbms="postgresql">
        <sql splitStatements="false">
            DO $$
            BEGIN
                IF to_regclass('field_form_config_concept') IS NOT NULL THEN
                    ALTER TABLE field_form_config_concept
                    ADD COLUMN IF NOT EXISTS branch_name varchar(255),
                    ADD COLUMN IF NOT EXISTS collection_name varchar(255);
                END IF;
            END
            $$;
        </sql>
    </changeSet>

</databaseChangeLog>
