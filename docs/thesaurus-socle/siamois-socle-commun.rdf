	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Carré</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Grid square</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0206&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1128&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1163</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1164&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Dépôt</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Deposit</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ablagerung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_depot</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1142&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1136&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g100&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g104&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g105&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g106&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1164</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Typ einer Aufzeichnungseinheit mit materieller Mächtigkeit, die aus einem anthropogenen oder natürlichen Akkretionprozess resultiert [z. B. Aufgabe, Sedimentation, Bauaktivitäten…].</skos:definition>
	<skos:definition xml:lang="en">Type of recording unit with material thickness, resulting from an accretion process of either anthropogenic or natural origin [e.g., abandonment, sedimentation, construction…].</skos:definition>
	<skos:definition xml:lang="fr">Type d'unité d'enregistrement pourvue d'une épaisseur matérielle, résultant d'un processus d'accrétion anthropique ou naturelle [abandon, sédimentation, construction…].</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1165&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Erosion</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Erosion</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Erosion</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_erosion</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1139&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1140&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1141&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1136&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g100&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g104&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g105&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1165</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="en">Type of recording unit without material thickness, marked only by an interface, resulting from artificial and/or natural material removal, such as an excavation (e.g., a pit) or a truncation feature (e.g., stair tread wear, wall leveling). It can occur prior to or after other field units and is the only type of recording unit that cannot contain artifacts.</skos:definition>
	<skos:definition xml:lang="fr">Type d'unité d'enregistrement sans épaisseur matérielle, marquée seulement par une interface, résultant d'un retrait de matière artificiel et/ou naturel, comme un creusement (ex. : une fosse) ou une trace d'arasement (ex. : usure d'une marche d'escalier, dérasement de mur, etc.), situable antérieurement ou postérieurement aux autres unités du terrain. C'est le seul type d'unité d'enregistrement qui ne peut pas contenir de mobilier.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1166&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Altération</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Weathering</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Verwitterung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_altération</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1142&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1136&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g100&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g104&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1166</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Typ einer Aufzeichnungseinheit, der einem in-situ-Transformationsphänomen entspricht (z. B. Pedogenese, physiko-chemische Umwandlung wie Rötung durch thermische Einwirkung auf eine Ofenwand oder mechanische Umwandlung wie eine gepflügte Schicht), das vor oder nach anderen Geländeeinheiten auftreten und als ein die Chronologie der Fundstelle prägendes Ereignis dokumentiert werden kann.</skos:definition>
	<skos:definition xml:lang="en">Type of recording unit corresponding to an in-situ transformation phenomenon (e.g., pedogenesis, physico-chemical transformation such as rubefaction resulting from thermal impact on a furnace wall, or mechanical transformation such as a plowed layer), which may occur prior to or after other field units and be recorded as a constitutive event in the site's chronology.</skos:definition>
	<skos:definition xml:lang="fr">Type d'unité d'enregistrement correspondant à un phénomène de transformation sur place (pédogénèse, transformation physico-chimique telle la rubéfaction résultant de l'impact thermique sur une paroi de four, transformation mécanique telle une couche labourée, etc.), qui peut être située antérieurement et postérieurement aux autres unités de terrain, et être enregistrée comme un événement constitutif de la chronologie du site.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1167&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Composite</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Composite</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Zusammengesetzt</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_composite</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1142&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1136&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g100&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g104&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g106&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1167</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Typ einer Aufzeichnungseinheit, der mehrere nicht klar abgrenzbare Phasen des Erosions-Ablagerungs-Verwitterungs-Zyklus dokumentiert. Er kann sowohl auf zusammengesetzte als auch auf elementare Einheiten angewendet werden.</skos:definition>
	<skos:definition xml:lang="en">Type of recording unit reflecting multiple indistinct actions within the erosion-deposition-weathering cycle. It can apply to both composite and elementary units.</skos:definition>
	<skos:definition xml:lang="fr">Type d'unité d'enregistrement témoignant de plusieurs étapes indistinctes du cycle érosion-dépôt-altération. Il peut s'appliquer à une unité incluante comme à une unité élémentaire.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1168&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Agent naturel</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Natural agent</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Natürliches Agens</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_agent_naturel</skos:altLabel>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1137&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1168</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Natürlicher Prozess, der direkt zur Bildung der betrachteten stratigraphischen Einheit führt.</skos:definition>
	<skos:definition xml:lang="en">Natural process directly leading to the formation of the stratigraphic unit under consideration.</skos:definition>
	<skos:definition xml:lang="fr">Action d'origine naturelle menant directement à la formation de l'unité stratigraphique considérée.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1169&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Agent anthropique</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Human agent</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Anthropogenes Agens</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_agent_anthropique</skos:altLabel>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1137&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1169</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Menschlich bedingte Prozesse, die direkt zur Bildung der betrachteten stratigraphischen Einheit führen.</skos:definition>
	<skos:definition xml:lang="en">Human-induced action directly leading to the formation of the stratigraphic unit under consideration.</skos:definition>
	<skos:definition xml:lang="fr">Action d'origine humaine menant directement à la formation de l'unité stratigraphique considérée.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1170&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Agent anthropique et naturel</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Anthropogenic and natural agents</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Anthropogene und natürliche Agenzien</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_agent_anthropique_et_naturel</skos:altLabel>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1137&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1170</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Gemischte anthropogene und natürliche Prozesse (z. B. mittelalterliche Schwarderden), die direkt zur Bildung der betrachteten stratigraphischen Einheit führen.</skos:definition>
	<skos:definition xml:lang="en">Mixed anthropogenic and natural processes (e.g., medieval dark earths) directly leading to the formation of the stratigraphic unit under consideration.</skos:definition>
	<skos:definition xml:lang="fr">Action mixte d'origine à la fois humaine et naturelle (ex. : les terres noires médiévales) menant directement à la formation de l'unité stratigraphique considérée.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1171&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Agent indéterminé</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Undetermined agent</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Unbestimmtes Agens</skos:prefLabel>
	<skos:altLabel xml:lang="fr">LBL_agent_indetermine</skos:altLabel>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1137&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1171</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Prozess, der direkt zur Bildung der betrachteten stratigraphischen Einheit führt, dessen anthropogene oder natürliche Herkunft nicht bestimmt werden konnte (z. B. eine unstrukturierte Steinansammlung).</skos:definition>
	<skos:definition xml:lang="en">Process directly leading to the formation of the stratigraphic unit under consideration, with an undetermined origin (either anthropogenic or natural), such as an unstructured stone accumulation.</skos:definition>
	<skos:definition xml:lang="fr">Action menant directement à la formation de l'unité stratigraphique considérée dont l'origine humaine ou naturelle n'a pas pu être déterminée (par exemple un empierrement informe).</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1172&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Argile naturelle (altération du substrat)</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Natural clay (substrate alteration)</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Natürlicher Ton (Substratverwitterung)</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PN4 - Argile naturelle (altération du substrat)</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1172</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die durch die natürliche Umwandlung des Ausgangsgesteins in tonhaltiges Material entsteht, bedingt durch chemische, physikalische oder mechanische Verwitterung des Substrats. Sie spiegelt die geologischen oder pedologischen Prozesse wider, die das ursprüngliche Gestein verändert haben, und bildet einen nutzbaren Boden- oder Substrathorizont für menschliche Aktivitäten.</skos:definition>
	<skos:definition xml:lang="en">Deposit formed by the natural transformation of parent rock into clayey material, resulting from chemical, physical, or mechanical weathering of the substrate. It reflects the geological or pedological processes that have modified the original rock and constitutes a soil or substrate horizon usable for human activities.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué par la transformation naturelle de la roche mère en matériau argileux, résultant de l’altération chimique, physique ou mécanique du substrat. Il reflète les processus géologiques ou pédologiques ayant modifié la roche originelle et constitue un horizon de sol ou de substrat exploitable par les activités humaines.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1173&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Armature de poutres</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Timber beam armature</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Balkenkonstruktion</skos:prefLabel>
	<skos:altLabel xml:lang="fr">E53 - Armature de poutres</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1173</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Interne Holzkonstruktion aus horizontalen, regelmäßig angeordneten Balken, die manchmal durchgehend sind und die Kohäsion, Stabilität und mechanische Widerstandsfähigkeit des Murus Gallicus gewährleisten. Sie verbindet die äußere und innere Verkleidung der Wallanlage und bildet das tragende Gerüst der Konstruktion, in Kombination mit Stein und Erde.</skos:definition>
	<skos:definition xml:lang="en">Internal wooden structure composed of horizontal beams arranged in regular rows, sometimes continuous, ensuring the cohesion, stability, and mechanical resistance of the murus gallicus. It connects the external and internal facings of the rampart and forms the load-bearing skeleton of the construction, in combination with stone and earth.</skos:definition>
	<skos:definition xml:lang="fr">Structure interne en bois constituée de poutres horizontales disposées en rangées régulières, parfois traversantes, assurant la cohésion, la stabilité et la résistance mécanique du murus gallicus. Elle relie les parements externe et interne du rempart et forme le squelette porteur de la construction, en association avec la pierre et la terre.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1174&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Autre dépôt</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Other deposit</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sonstige Ablagerung</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1174</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Generischer Begriff, der ausgewählt wird, wenn die Art der beobachteten Ablagerung keinem der in der Werteliste aufgeführten Ablagerungstypen entspricht. Diese Auswahl ermöglicht es, eine spezifische Form natürlicher oder anthropogener Ablagerungen zu kennzeichnen und deren Beschreibung in einem zusätzlichen Freitextfeld vorzuschlagen, um den Wortschatz der Instanz zu erweitern.</skos:definition>
	<skos:definition xml:lang="en">Generic term to be selected when the nature of the observed deposit does not correspond to any type of deposit listed in the value set. This choice allows for the identification of a specific form of natural or anthropogenic deposit and the proposal of its description in an additional free-text field, with the aim of enriching the vocabulary of the instance.</skos:definition>
	<skos:definition xml:lang="fr">Terme générique à sélectionner lorsque la nature du dépôt observé ne correspond à aucun type de dépôt répertorié dans la liste de valeur. Ce choix permet de signaler une forme particulière de dépôt naturel ou anthropique et d'en proposer la description dans un champ complémentaire (texte libre) à des fins d'enrichissement du vocabulaire de l'instance.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1175&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Autre incluante</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Other inclusive unit</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sonstige umfassende Einheit</skos:prefLabel>
	<skos:altLabel xml:lang="fr">E99 - Autre</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1175</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Generischer Begriff, der ausgewählt wird, wenn die Art der beobachteten umfassenden Einheit keinem der in der Werteliste aufgeführten Typen entspricht. Diese Auswahl ermöglicht es, eine spezifische Form der umfassenden Einheit zu kennzeichnen und deren Beschreibung in einem zusätzlichen Freitextfeld vorzuschlagen, um den Wortschatz der Instanz zu erweitern.</skos:definition>
	<skos:definition xml:lang="en">Generic term to be selected when the nature of the observed inclusive unit does not correspond to any type listed in the value set. This choice allows for the identification of a specific form of inclusive unit and the proposal of its description in an additional free-text field, with the aim of enriching the vocabulary of the instance.</skos:definition>
	<skos:definition xml:lang="fr">Terme générique à sélectionner lorsque la nature de l'unité incluante observée ne correspond à aucun type répertorié dans la liste de valeur. Ce choix permet de signaler une forme particulière d'unité incluante et d'en proposer la description dans un champ complémentaire (texte libre) à des fins d'enrichissement du vocabulaire de l'instance.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1176&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Autre érosion</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Other erosion</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Sonstige Erosion</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1176</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Generischer Begriff, der ausgewählt wird, wenn die beobachtete Erosionsform keinem der in der Werteliste aufgeführten Erosionstypen entspricht. Diese Auswahl ermöglicht es, eine spezifische Form natürlicher oder anthropogener Erosion zu kennzeichnen und deren Beschreibung in einem zusätzlichen Freitextfeld vorzuschlagen, um den Wortschatz der Instanz zu erweitern.</skos:definition>
	<skos:definition xml:lang="en">Generic term to be selected when the observed form of erosion does not correspond to any type of erosion listed in the value set. This choice allows for the identification of a specific form of natural or anthropogenic erosion and the proposal of its description in an additional free-text field, with the aim of enriching the vocabulary of the instance.</skos:definition>
	<skos:definition xml:lang="fr">Terme générique à sélectionner lorsque la forme d'érosion observée ne correspond à aucun type d'érosion répertorié dans la liste de valeur. Ce choix permet de signaler une forme particulière d'érosion naturelle ou anthropique et d'en proposer la description dans un champ complémentaire (texte libre) à des fins d'enrichissement du vocabulaire de l'instance.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1177&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Bassin</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Basin</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Becken</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA66 - Bassin</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1177</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die einer künstlichen oder natürlichen Vertiefung entspricht, die dazu bestimmt ist, Wasser zu sammeln oder zu kanalisieren.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to an artificial or natural depression designed to collect or channel water.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à une dépression artificielle ou naturelle destinée à recueillir ou canaliser l'eau.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1178&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Bâtiment</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Structure</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bauwerk</skos:prefLabel>
	<skos:altLabel xml:lang="fr">E01 - Bâtiment</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1178</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Eine architektonische Konstruktion, die durch materielle Überreste (Fundamente, Mauern, Böden, Dachstrukturen etc.) und/oder indirekte Spuren (Pfostenlöcher, Ansammlungen spezifischer Materialien, assoziierte Artefakte) identifizierbar ist und dem Schutz von Menschen, Tieren oder Gütern dient.</skos:definition>
	<skos:definition xml:lang="en">An architectural construction identifiable by its material remains (foundations, walls, floors, roofs, etc.) and/or indirect traces (postholes, accumulations of purposeful materials, associated artifacts), intended to shelter people, animals, or goods.</skos:definition>
	<skos:definition xml:lang="fr">Construction architecturale identifiable par ses vestiges matériels (fondations, murs, sols, toitures, etc.) et/ou par des traces indirectes (trous de poteaux, accumulations de matériaux appropriés, artefacts associés), destinée à abriter des personnes, des animaux ou des biens.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1179&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Canalisation</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Pipe</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Rohrleitung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA74 - Tuyauterie</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1179</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ein Leitungssystem, das zur Beförderung von Wasser, Flüssigkeiten oder Fluiden in einer Struktur bestimmt ist. Es kann Elemente aus Ton, Metall, Stein oder Holz umfassen und spiegelt die technische Gestaltung eines hydraulischen oder häuslichen Netzwerks wider.</skos:definition>
	<skos:definition xml:lang="en">A conduit designed for the conveyance of water, liquids, or fluids within a structure. It may include elements made of clay, metal, stone, or wood, and reflects the technical arrangement of a hydraulic or domestic network.</skos:definition>
	<skos:definition xml:lang="fr">Conduit destiné à l’acheminement de l’eau, des liquides ou des fluides dans une structure. Il peut inclure des éléments en terre cuite, métal, pierre ou bois, et reflète l’aménagement technique d’un réseau hydraulique ou domestique.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1180&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Cave</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Cellar</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Keller</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA70 - Cave</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1180</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die einem unterirdischen, ganz oder teilweise vergrabene Raum entspricht, der für Lagerung, Wohnen oder Nutzung ausgegraben wurde.</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to an underground space dug for storage, habitation, or exploitation, partially or fully buried.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à un volume souterrain creusé pour le stockage, l'habitat ou l'exploitation, partiellement ou totalement enfoui.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1181&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Couche d'occupation</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Occupation layer</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Besiedlungsschicht</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA2 - Couche d'occupation</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1181</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die durch die schrittweise und kontinuierliche Ansammlung anthropogener Materialien oder durch die Überlagerung mehrerer Böden entsteht, zwischen denen weniger klar identifizierbare Phasen der Aufgabe liegen, insbesondere aus sedimentologischer Sicht.</skos:definition>
	<skos:definition xml:lang="en">Deposit formed by the gradual and continuous accumulation of anthropogenic materials or by the superposition of multiple soils, interspersed with less identifiable periods of abandonment from a sedimentological perspective.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt formé par l'accumulation progressive et continuelle de matériaux anthropiques ou par la superposition de plusieurs sols entrecoupés de périodes d'abandon moins identifiables d'un point de vue sédimentologique.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1182&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Couche de démolition</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Demolition layer</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Abrissschicht</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA1 - Couche de démolition</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1182</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung bestehend aus Materialien, die aus der absichtlichen Zerstörung oder dem Einsturz einer Struktur stammen.</skos:definition>
	<skos:definition xml:lang="en">Deposit consisting of materials from the intentional destruction or collapse of a structure.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué de matériaux provenant de la destruction ou de l'effondrement volontaire d'une structure.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1183&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Dépôt alluvionnaire</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Alluvial deposit</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Alluviale Ablagerung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PN5 - Dépôt alluvionnaire</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1183</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die durch die Ansammlung von Sedimenten entsteht, die durch Wasser transportiert und abgelagert wurden, meist in einem fluvialen oder wildbachartigen Kontext. Sie besteht aus verschiedenen Materialien (Sand, Schluff, Kies), die in Schichten angeordnet sind, und zeugt von natürlichen hydrologischen Dynamiken, die die Topographie und Stratigraphie des Standortes beeinflussen können.</skos:definition>
	<skos:definition xml:lang="en">Deposit formed by the accumulation of sediments transported and deposited by water, typically in a fluvial or torrential context. It consists of varied materials (sands, silts, gravels) arranged in layers and reflects natural hydrological dynamics that can influence the topography and stratigraphy of the site.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt formé par l’accumulation de sédiments transportés et déposés par l’eau, généralement dans un contexte fluviatile ou torrentiel. Il se compose de matériaux variés (sables, limons, graviers) disposés en couches et témoigne de dynamiques hydrologiques naturelles pouvant influencer la topographie et la stratigraphie du site.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1184&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Dépôt colluvionnaire</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Colluvial deposit</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Kolluviale Ablagerung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PN6 - Dépôt colluvionnaire</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1184</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, gebildet durch die Akkumulation von Materialien, die durch Schwerkraft transportiert werden, wie Blöcke, Kiese, Schluffe oder Erden, die aus Oberflächenabfluss, Erdrutschen oder Felsstürzen stammen. Sie zeichnet sich durch eine heterogene Zusammensetzung aus und belegt natürliche Prozesse der Erosion und Umverteilung von Sedimenten an Hängen oder am Fuß von Böschungen.</skos:definition>
	<skos:definition xml:lang="en">Deposit formed by the accumulation of materials transported by gravity, such as blocks, gravel, silt, or soil, derived from surface runoff, landslides, or rockfalls. It is characterized by a heterogeneous composition and reflects natural processes of erosion and sediment redistribution on slopes or at the base of hillsides.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt formé par l’accumulation de matériaux transportés par gravité, tels que blocs, graviers, limons ou terres, issus du ruissellement, de glissements de terrain ou d’éboulements. Il se caractérise par une composition hétérogène et témoigne de processus naturels d’érosion et de redistribution des sédiments sur les pentes ou en bas de versants.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1185&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Effondrement de mur</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Wall collapse</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Mauereinsturz</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA31 - Mur écroulé</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1185</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die aus den Materialien besteht, die durch den Einsturz einer Mauer entstanden sind, einschließlich Blöcke, Bruchsteine, Ziegel und gegebenenfalls Mörtel oder Füllmaterialien. Sie zeugt von der Zerstörung, dem Verfall oder dem zufälligen Einsturz einer Struktur und kann die Spuren der ursprünglichen Mauerwerksstruktur bewahren.</skos:definition>
	<skos:definition xml:lang="en">Deposit consisting of materials resulting from the collapse of a wall, including blocks, rubble, bricks, and possibly mortar or filling elements. It bears witness to the destruction, abandonment, or accidental collapse of a structure and may preserve the imprint of the original masonry.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué des matériaux résultant de l’écroulement d’un mur, incluant les blocs, moellons, briques et éventuellement le mortier ou les éléments de remplissage. Il témoigne de la destruction, de l’abandon ou de l’effondrement accidentel d’une structure, et peut conserver l’empreinte de la maçonnerie initiale.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1186&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Empreinte de poteau</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Post imprint</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pfostenabdruck</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA51 - Empreinte de poteau</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1186</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die der Stelle entspricht, die von einem verschwundenen Pfosten oder Pfeiler hinterlassen wurde, der sich in der Regel in einem größeren und tieferen Pfostenloch befand.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to the mark left by a disappeared post or pillar, typically within a larger and deeper posthole.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à l'emplacement laissé par un poteau ou pilier ayant disparu et qui s'insérait dans la cavité généralement plus large et plus profonde qu'est le trou de poteau.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1187&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Enduit de surface</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Surface render</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Oberflächenputz</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA72 - Enduit</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1187</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Dünne, auf eine Oberfläche (Wand, Boden oder ein anderes architektonisches Bauteil) aufgetragene Schicht, die dem Schutz, der Dekoration oder der Oberflächenveredelung dient. Sie kann aus Mörtel, Gips, Kalk, Lehm oder anderen Materialien bestehen und zeigt eine menschliche Bearbeitung, die darauf abzielt, die Haltbarkeit oder das ästhetische Erscheinungsbild einer Struktur zu verbessern.</skos:definition>
	<skos:definition xml:lang="en">A thin layer applied to a surface (wall, floor, or other architectural support) for protective, decorative, or finishing purposes. It may be composed of mortar, plaster, lime, clay, etc., and reflects human intervention aimed at enhancing the durability or aesthetic appearance of a structure.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt mince appliqué sur une surface (mur, sol ou autre support architectural) à des fins de protection, de décoration ou de finition. Il peut être constitué de mortier, plâtre, chaux, terre, etc., et reflète une intervention humaine visant à améliorer la durabilité ou l’aspect esthétique d’une structure.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1188&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Ensemble clos</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Closed context</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Geschlossener Fund</skos:prefLabel>
	<skos:altLabel xml:lang="fr">E90 - Ensemble clos</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1188</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ein ungestörter archäologischer Komplex, bestehend aus zeitgleichen Objekten, Strukturen oder Ablagerungen, die in einem gemeinsamen Kontext eingeschlossen sind und keine späteren Störungen erfahren haben. Ein geschlossener Fundkomplex ermöglicht die Erstellung einer präzisen relativen Chronologie und die Dokumentation einer einzigartigen Phase der Nutzung oder Aufgabe.</skos:definition>
	<skos:definition xml:lang="en">An undisturbed archaeological assemblage consisting of contemporary objects, structures, or deposits sealed within a single context and not subjected to subsequent disturbances. A sealed assemblage allows for the establishment of a precise relative chronology and the documentation of a unique phase of occupation or abandonment.</skos:definition>
	<skos:definition xml:lang="fr">Ensemble archéologique non remanié, constitué d’objets, de structures ou de dépôts contemporains, scellés dans un même contexte et n’ayant pas subi de perturbations postérieures. Un ensemble clos permet d’établir une chronologie relative précise et de documenter une phase unique d’occupation ou d’abandon.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1189&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Epandage</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Spreading</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Ausbreitung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA3 - Epandage</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1189</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die absichtlich oder zufällig auf einer Fläche verteilt wurde und organische oder mineralische Materialien enthalten kann.</skos:definition>
	<skos:definition xml:lang="en">Deposit spread intentionally or accidentally on a surface, which may include organic or mineral materials.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt étalé ou répandu intentionnellement ou accidentellement sur une surface, pouvant inclure des matériaux organiques ou minéraux.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1190&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Fondation maçonnée</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Masonry foundation</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Gemauertes Fundament</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA29 - Maçonnerie de fondation</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1190</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die aus einer Ansammlung von Blöcken, Geröll oder Bruchsteinen besteht, die mit oder ohne Mörtel verbunden sind und die Basis einer gebauten Struktur bilden. Sie gewährleistet die Stabilität und die Verteilung der Lasten der Erhebung auf dem Boden und kann teilweise oder vollständig im Untergrund eingebettet sein.</skos:definition>
	<skos:definition xml:lang="en">Deposit consisting of an assembly of blocks, cobblestones, or rubble, bonded or unbonded by mortar, forming the base of a built structure. It ensures the stability and load distribution of the elevation on the ground and may be partially or completely buried in the substrate.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué d’un assemblage de blocs, galets ou moellons liés ou non par un mortier, formant la base d’une structure bâtie. Elle assure la stabilité et la répartition des charges de l’élévation sur le sol, et peut être partiellement ou totalement enfouie dans le substrat.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1191&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Fosse</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Pit</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Grube</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA33 - Fosse</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1191</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die einer punktuellen Vertiefung im Boden entspricht, die zur Lagerung, Bestattung oder Entsorgung von Materialien, Ablagerungen oder Objekten bestimmt war.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to a punctual excavation in the soil, intended for storing, burying, or discarding materials, deposits, or objects.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à un creusement ponctuel dans le sol, destiné à stocker, enterrer ou jeter des matériaux, dépôts ou objets.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1192&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Fosse de fondation</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Foundation pit</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Fundamentgrube</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA34 - Fosse de fondation</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1192</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die dem Aushub für die Aufnahme der Fundamente einer gebauten Struktur entspricht.﻿</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to the excavation made to accommodate the foundations of a built structure.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant au creusement réalisé pour accueillir les fondations d'une structure bâtie.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1193&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Fossé rigole</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Drainage ditch</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Entwässerungsgraben</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA36 - Fossé rigole</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1193</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Schmale und lineare Erosion, oft von geringer Tiefe, die zur Drainage oder Wasserableitung dient.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Narrow and linear erosion, often shallow, used for drainage or water evacuation.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion étroite et linéaire, souvent de faible profondeur, servant au drainage ou à l'évacuation des eaux.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1194&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Foyer complexe ou four</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Complex hearth or furnace</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Komplexe Feuerstelle oder Ofen</skos:prefLabel>
	<skos:altLabel xml:lang="fr">E20 - Foyer complexe ou four</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1194</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Eine konstruierte Anlage zur Wärmeerzeugung, zum Kochen oder zur Materialverarbeitung, bestehend aus Elementen wie Vertiefungen, Stein- oder Lehmkonstruktionen, Herdflächen, Gewölben oder Kanälen. Sie kann mehrere Abteile, Ebenen oder zugehörige Vorrichtungen aufweisen und ist durch das Vorhandensein von Verbrennungsrückständen wie Asche, Holzkohle oder gerötetem Material gekennzeichnet, was auf eine wiederholte oder spezialisierte Nutzung hinweist.</skos:definition>
	<skos:definition xml:lang="en">A constructed structure designed for heat production, cooking, or material transformation, composed of elements such as hollows, stone or earth arrangements, hearth floors, vaults, or flues. It may feature multiple compartments, levels, or associated devices and is characterized by the presence of combustion residues—ashes, charcoal, or rubefied materials—evidencing repeated or specialized use.</skos:definition>
	<skos:definition xml:lang="fr">Structure aménagée pour la production de chaleur, la cuisson ou la transformation de matériaux, constituée d’éléments tels que creusement, aménagements en pierre ou terre, sole, voûte ou conduits. Elle peut présenter plusieurs compartiments, niveaux ou dispositifs associés, et se caractérise par la présence de résidus de combustion, cendres, charbons ou matériaux rubéfiés, témoignant de son usage répété ou spécialisé.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1195&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Foyer simple</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Simple hearth</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Einfache Feuerstelle</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA73 - Foyer simple</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1195</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die durch begrenzte Verbrennungsvorgänge — etwa beim Heizen oder Kochen — entstanden ist. Sie umfasst oft Asche, Holzkohle, verbrannte Holzreste oder andere brennbare Rückstände und belegt die einmalige oder wiederholte Nutzung einer Stelle zur Feuererzeugung.</skos:definition>
	<skos:definition xml:lang="en">Deposit corresponding to a limited combustion point, resulting from heating or cooking activities. It may include ashes, charcoal, burned wood fragments, or other combustible residues, and reflects the occasional or recurrent use of a location for fire production.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt correspondant à un point de combustion limité, résultant d’activités de chauffage ou de cuisson. Il peut inclure des cendres, charbons, fragments de bois brûlé ou autres résidus combustibles, et témoigne de l’usage ponctuel ou récurrent d’un emplacement pour produire du feu.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1196&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Hypocauste</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Hypocaust</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Hypokaustum</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA75 - Hypocauste</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1196</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Einrichtung, die einem Heizsystem durch Zirkulation von warmer Luft unter einem erhöhten Boden entspricht. Es umfasst Säulen, Leitungen oder Hohlräume, die für den Luftdurchlass vorgesehen sind, und kann Spuren von Mörtel, Ziegeln oder Elementen enthalten, die mit der Bodenstruktur verbunden sind. Es zeugt von einer technischen Gestaltung, die dem thermischen Komfort eines bebauten Raumes dient.</skos:definition>
	<skos:definition xml:lang="en">Device corresponding to a heating system by circulation of hot air under a raised floor. It includes pillars, conduits, or voids left for the passage of air and may feature traces of mortar, bricks, or elements related to the floor structure. It attests to a technical arrangement intended for the thermal comfort of a built space.</skos:definition>
	<skos:definition xml:lang="fr">Dispositif correspondant à un système de chauffage par circulation d’air chaud sous un sol surélevé. Il inclut les piliers, conduits ou vides laissés pour le passage de l’air et peut comporter des traces de mortier, de briques ou d’éléments liés à la structure du sol. Il témoigne d’un aménagement technique destiné au confort thermique d’un espace bâti.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1197&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Indéterminé</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Undetermined</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Unbestimmt</skos:prefLabel>
	<skos:altLabel xml:lang="fr">P1 - Indéterminé</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1158&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g110&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1197</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, Ablagerung, Verwitterung Zusammengesetzt oder Umfassende Einheit, deren Art oder Funktion im Gelände nicht bestimmt werden konnte.</skos:definition>
	<skos:definition xml:lang="en">Erosion, deposition, weathering, composite or inclusive unit whose nature or function could not be identified in the field.</skos:definition>
	<skos:definition xml:lang="fr">Erosion, dépôt, altération, composite ou incluante dont la nature ou la fonction n'a pas pu être identifiée sur le terrain.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1198&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Inhumation</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Burial</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bestattung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA81 - Dépôt d'inhumation</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1158&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g110&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1198</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die durch die Platzierung eines Körpers oder menschlicher Überreste in einem Grab besteht. Sie kann das Skelett oder Knochenfragmente umfassen, möglicherweise begleitet von Grabbeigaben, und zeugt von rituellen Praktiken oder der Organisation des Bestattungsraumes.</skos:definition>
	<skos:definition xml:lang="en">Deposit formed by the placement of a body or human remains in a burial site. It may include the skeleton or bone fragments, possibly accompanied by funerary goods, and attests to ritual practices or the organization of the funerary space.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué par la mise en place d’un corps ou de restes humains dans une sépulture. Il peut inclure le squelette ou des fragments osseux, éventuellement accompagnés de mobilier funéraire, et témoigne de pratiques rituelles ou de l’organisation de l’espace funéraire.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1199&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Mur maçonné</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Masonry wall</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Gemauertes Mauerwerk</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA30 - Maçonnerie, mur</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1199</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die aus einer Ansammlung von Blöcken, Kieseln oder Bruchsteinen besteht, die mit oder ohne Mörtel verbunden sind und die Basis einer gebauten Struktur bilden. Sie sorgt für die Stabilität und die Lastverteilung der Erhebung auf dem Boden und kann teilweise oder vollständig im Untergrund vergraben sein.</skos:definition>
	<skos:definition xml:lang="en">Deposit consisting of an assembly of blocks, pebbles, or rubble, bonded or unbonded by mortar, forming the base of a built structure. It ensures the stability and load distribution of the elevation on the ground and may be partially or completely buried in the substrate.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué d’un assemblage de blocs, moellons ou briques, liés ou non par un mortier, formant une élévation verticale. Il délimite, soutient ou cloisonne un espace et peut appartenir à une structure porteuse, de soutènement ou de fermeture.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1200&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Murus gallicus</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Murus gallicus</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Murus gallicus</skos:prefLabel>
	<skos:altLabel xml:lang="fr">E50 - Murus gallicus externe</skos:altLabel>
	<skos:altLabel xml:lang="fr">E51 - Murus gallicus interne</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1200</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Typ keltischer Wallanlage, gekennzeichnet durch eine interne Holzkonstruktion aus horizontalen und vertikalen Balken, kombiniert mit einer Füllung aus Erde oder Steinblöcken und oft mit einer äußeren Steinverkleidung versehen.</skos:definition>
	<skos:definition xml:lang="en">Type of Gallic rampart characterized by an internal wooden framework of horizontal and vertical beams, combined with an infill of earth or stone blocks, and often featuring an external stone facing.</skos:definition>
	<skos:definition xml:lang="fr">Type de rempart gaulois caractérisé par une ossature interne en bois horizontale et verticale, combinée à un remplissage de terre ou de blocs et souvent dotée d'un parement externe en pierre.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1201&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Niveau d'incendie</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Fire level</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Brandschicht</skos:prefLabel>
	<skos:altLabel xml:lang="fr">X2 - Niveau d'incendie</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1201</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die aus Rückständen eines Brandes besteht, darunter Asche, Holzkohle, gerötete oder verkohlte Materialien sowie gelegentlich durch Hitze veränderte Gegenstände. Sie entsteht durch ein ausgedehntes Verbrennungsereignis, das ein Gebäude, eine Struktur oder eine Nutzfläche betroffen hat, und ist durch eine spezifische Färbung, Textur oder Zusammensetzung gekennzeichnet, die auf die Einwirkung des Feuers zurückzuführen ist.</skos:definition>
	<skos:definition xml:lang="en">Deposit composed of fire residues, including ash, charcoal, rubefied or carbonized materials, and occasionally heat-altered objects. It results from an extensive combustion event affecting a building, structure, or occupation surface, and is characterized by a specific hue, texture, or composition linked to the action of fire.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué des résidus d’un incendie, incluant cendres, charbons, matériaux rubéfiés ou carbonisés, et parfois objets altérés par la chaleur. Il résulte d’un épisode de combustion étendu ayant affecté un bâtiment, une structure ou une surface d’occupation, et se caractérise par une teinte, une texture ou une composition spécifique liée à l’action du feu.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1202&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Ornière</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Rut</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Spurrille</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA37 - Ornière</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1202</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Lineare und schmale Erosion, die durch den wiederholten Durchgang von Rädern oder Maschinen auf dem Boden entsteht.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Narrow and linear erosion produced by the repeated passage of wheels or machinery on the ground.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion linéaire et étroite produite par le passage répété de roues ou engins sur le sol.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1203&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Puits</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Well</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Brunnen</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA65 - Puits</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1203</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Vertikale Erosion, die ausgegraben wurde, um Grundwasser zu erreichen oder Materialien zu extrahieren.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Vertical erosion dug to access groundwater or extract materials.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion verticale creusée pour accéder à une nappe d'eau ou pour l'extraction de matériaux.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1204&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Pédogénèse, humus</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Pedogenesis, humus</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bodenbildung, Humus</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PN3 - Pédogénèse, humus</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1204</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die durch die Bildung und Ansammlung organischer Substanz sowie von Bodenhorizonten entsteht, die aus natürlichen pedologischen Prozessen resultieren. Sie umfasst Humus, organisch angereicherte Oberbodenhorizonte und chemische oder physikalische Umwandlungen des Substrats und zeugt von der natürlichen Entwicklung des Bodens an der Stelle.</skos:definition>
	<skos:definition xml:lang="en">Deposit formed by the accumulation of organic matter and soil horizons resulting from natural pedological processes. It includes humus, organically enriched surface horizons, and chemical or physical transformations of the substrate, reflecting the natural evolution of the soil at the site.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué par la formation et l’accumulation de matière organique et d’horizons de sol résultant de processus pédologiques naturels. Il inclut l’humus, les horizons superficiels enrichis en matière organique et les transformations chimiques ou physiques du substrat, et témoigne de l’évolution naturelle du sol sur le site.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1205&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Radier</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Foundation slab</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Fundamentplatte</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA70 - Radier de sol</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1205</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Eine vorbereitete Schicht, oft aus Steinen, Blöcken oder verdichteten Materialien, die eine stabile und ebene Basis für den Bau einer Struktur bildet. Sie verteilt die Lasten der Erhebung, gewährleistet die Stabilität des Gebäudes und kann teilweise vergraben oder bündig mit der Oberfläche sein.</skos:definition>
	<skos:definition xml:lang="en">A prepared layer, often of stones, blocks, or compacted materials, forming a stable and level base on which a structure will be built. It distributes the loads of the elevation, ensures the stability of the building, and may be partially buried or flush with the surface.</skos:definition>
	<skos:definition xml:lang="fr">Couche aménagée, souvent de pierres, de blocs ou de matériaux compactés, formant une base stable et nivelée sur laquelle sera construite une structure. Il répartit les charges de l’élévation, assure la stabilité du bâtiment et peut être partiellement enterré ou affleurant.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1206&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Remblai</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Fill</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Auffüllung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA4 - Remblai</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1206</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Künstliche Ablagerung, die dazu dient, das Gelände aufzufüllen, zu nivellieren oder anzuheben.</skos:definition>
	<skos:definition xml:lang="en">Artificial deposit used to fill, level, or raise the ground.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt artificiel servant à combler, niveler ou surélever le terrain.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1207&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Remblai de fossé</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Ditch fill</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Grabenverfüllung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA5 - Remblai de fossé</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1207</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Künstliche Ablagerung, die einen Graben auffüllt, nivelliert oder anhebt.</skos:definition>
	<skos:definition xml:lang="en">Artificial deposit used to fill, level, or raise a ditch.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt artificiel comblant, nivelant ou surélevant un fossé.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1208&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Remplissage de tranchée de fondation</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Foundation trench backfill</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Auffüllung des Fundamentgrabens</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA36 - Remplissage fondation</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1208</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die den Aushub für eine Gründung nach dem Einbau der strukturellen Elemente verfüllt. Sie kann aus Erde, Steinen oder verschiedenen Materialien bestehen und zeugt von einer absichtlichen oder rückständigen Verfüllung des Raumes, der zur Stabilisierung der gebauten Struktur bestimmt ist.</skos:definition>
	<skos:definition xml:lang="en">Deposit filling the excavation made to accommodate a foundation after the placement of structural elements. It may consist of soil, stones, or various materials and reflects the intentional or residual filling of the space designed to stabilize the built structure.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt comblant le creusement réalisé pour accueillir une fondation après la mise en place des éléments structuraux. Il peut être constitué de terre, de pierres ou de matériaux divers et témoigne du comblement volontaire ou résiduel de l’espace destiné à stabiliser la structure bâtie.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1209&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Remplissage de tranchée de récupération</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Recovery trench fill</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Rückgewinnungsgrabenverfüllung</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA37 - Remplissage tranchée de récupération</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1209</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die einen Graben verfüllt, der zur Rückgewinnung von Materialien (Steine, Holz, Erde, usw.) oder zur Nutzung eines bestehenden Raumes ausgehoben wurde. Sie kann Rückstandssedimente oder später eingebrachte Materialien enthalten und spiegelt die Aufgabe oder Wiederherstellung des Grabens nach seiner Nutzung wider.</skos:definition>
	<skos:definition xml:lang="en">Deposit filling a trench excavated to recover materials (stones, wood, soil, etc.) or exploit an existing space. It may contain residual sediments or materials added later and reflects the abandonment or restoration of the trench after its use.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt comblant une tranchée creusée pour récupérer des matériaux (pierres, bois, terre, etc.) ou exploiter un espace existant. Il peut contenir des sédiments résiduels ou des matériaux apportés ultérieurement et reflète l’abandon ou la remise en état de la tranchée après son utilisation.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1210&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Restes d'incinération</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Cremation remains</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Verbrennungsreste</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA80 - Dépôt d'incinération</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1158&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g110&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1210</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die aus den Resten einer Verbrennung besteht, normalerweise Asche, Holzkohle, Knochenfragmente und Rückstände des Brennstoffs. Sie spiegelt die Durchführung eines Rituals oder einer freiwilligen Verbrennungsaktivität wider und kann die Anordnung oder Struktur der verbrannten Reste bewahren.</skos:definition>
	<skos:definition xml:lang="en">Deposit composed of the remains of an incineration, typically including ashes, charcoal, bone fragments, and residues related to the fuel. It reflects the implementation of a ritual or voluntary combustion activity and may preserve the arrangement or structure of the incinerated remains.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt constitué des restes d’une incinération, comprenant généralement des cendres, charbons, fragments osseux et résidus liés au combustible. Il reflète la mise en œuvre d’un rituel ou d’une activité de combustion volontaire et peut conserver la disposition ou la structure des restes incinérés.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1211&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Sol aménagé</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Constructed floor</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Bodenbelag</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA71 - Sol construit</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1211</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Geordnete Überlagerung von Materialien (Erde, Steine, Mörtel oder andere), die dazu dient, eine funktionale und langlebige Oberfläche zu schaffen. Sie kann einem Innen- oder Außenboden entsprechen, der für die Nutzung, den Verkehr oder die Unterstützung einer Struktur angelegt wurde.</skos:definition>
	<skos:definition xml:lang="en">Organized superposition of materials (earth, stones, mortar, or others) intended to create a functional and durable surface. It may correspond to an interior or exterior floor, arranged for occupation, circulation, or support of a structure.</skos:definition>
	<skos:definition xml:lang="fr">Superposition organisée de matériaux (terre, pierres, mortier ou autres), destinée à créer une surface fonctionnelle et durable. Il peut correspondre à un sol intérieur ou extérieur, aménagé pour l’occupation, la circulation ou le support d’une structure.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1212&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Structure de soutien maçonnée</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Masonry support structure</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Gemauerte Stützstruktur</skos:prefLabel>
	<skos:altLabel xml:lang="fr">X7 - Elément de soutien maçonné (colonne, pilier)</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1156&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g109&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1212</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Vertikales Mauerwerkbauwerk, das dazu dient, eine Last zu tragen, wie ein Gewölbe, eine Decke oder ein Dach. Es kann sich um eine Säule, einen Pfeiler oder ein gemauertes Massiv handeln, das teilweise erhalten oder eingestürzt ist, und zeugt von der architektonischen und konstruktiven Gestaltung eines Gebäudes.</skos:definition>
	<skos:definition xml:lang="en">Vertical masonry structure used to support a load, such as an arch, floor, or roof. It may take the form of a column, pier, or masonry mass, either partially preserved or collapsed, and reflects the architectural and structural organization of a building.</skos:definition>
	<skos:definition xml:lang="fr">Elément vertical en maçonnerie servant à soutenir une charge, telle qu’une voûte, un plancher ou une toiture. Il peut s’agir d’une colonne, d’un pilier ou d’un massif maçonné, partiellement conservé ou effondré, et témoigne de l’organisation architecturale et constructive d’un bâtiment.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1213&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Substrat rocheux</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Bedrock</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Felsuntergrund</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PN1 - Rocher en place</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1213</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Natürliches, anstehendes Gestein, das weder durch künstliche Prozesse verlagert noch verändert wurde. Es bildet den geologischen Untergrund, auf dem sich archäologische Strukturen oder Ablagerungen ansiedeln.</skos:definition>
	<skos:definition xml:lang="en">Natural outcropping rock, neither displaced nor altered by artificial processes. It constitutes the geological substrate upon which archaeological structures or deposits are established.</skos:definition>
	<skos:definition xml:lang="fr">Roche naturelle affleurante, non déplacée ni altérée par des processus artificiels. Il constitue le substrat géologique sur lequel s’implantent les structures ou les dépôts archéologiques.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1214&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Substrat rocheux altéré</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Altered bedrock</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Verwitterter Felsuntergrund</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PN2 - Rocher altéré</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1214</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Gestein, das natürlichen Verwitterungsprozessen wie Rissbildung, Erosion, chemischer oder mechanischer Alteration unterlegen ist. Es kann abgelöste Fragmente oder Oberflächenveränderungen umfassen und spiegelt die geologischen oder pedologischen Prozesse wider, die den natürlichen Untergrund beeinflussen.</skos:definition>
	<skos:definition xml:lang="en">Rock that has undergone natural alteration, such as cracking, erosion, chemical or mechanical weathering. It may include detached fragments or surface modifications and reflects the geological or pedological processes affecting the natural substrate.</skos:definition>
	<skos:definition xml:lang="fr">Roche ayant subi une altération naturelle, telle que fissuration, érosion, altération chimique ou mécanique. Il peut inclure des fragments détachés ou des modifications de surface et reflète les processus géologiques ou pédologiques affectant le substrat naturel.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1215&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Surface d'arasement</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Leveled surface</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Planierungsfläche</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA10 - Surface d'arasement</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1215</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die einer planierten oder nivellierten Fläche entspricht, die aus einem absichtlichen oder natürlichen Abtrieb resultiert.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to a planned or leveled surface resulting from intentional or natural leveling.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à une surface planifiée ou nivelée résultant d'un arasement intentionnel ou naturel.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1216&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Surface de rue</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Street surface</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Straßenoberfläche</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA13 - Surface de rue</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1216</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die dem Boden einer Verkehrsfläche entspricht, erkennbar an ihrer Gestaltung oder Nivellierung.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to the ground of a thoroughfare, identifiable by its layout or leveling.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant au sol d'une voie de circulation, identifiable par son aménagement ou son nivellement.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1217&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Terrasse</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Terrace</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Terrasse</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA15 - Terrasse</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1154&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g107&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1217</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die einem künstlich angelegten Niveau auf einem Hang entspricht, um den Boden zu stabilisieren oder einen nutzbaren Raum zu schaffen.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to an artificial level arranged on a slope, intended to stabilize the ground or create a usable space.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à un niveau artificiel aménagé sur un terrain en pente, destiné à stabiliser le sol ou créer un espace utilisable.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1218&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Tranchée de canalisation</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Utility trench</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Leitungsgraben</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA32 - Tranchée de canalisation</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1218</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Lineare Erosion, die ausgegraben wurde, um Leitungen, Rohre oder unterirdische Netze aufzunehmen.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Linear erosion dug to accommodate pipes, conduits, or underground networks.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion linéaire creusée pour accueillir des conduites, canalisations ou réseaux souterrains.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1219&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Tranchée de fondation (de mur)</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Wall foundation trench</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Fundamentgraben (für Mauer)</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA30 - Tranchée de fondation (de mur)</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1219</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Lineare Erosion, die dem Aushub für die Verlegung der Fundamente einer Mauer entspricht.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Linear erosion made for laying the foundations of a wall.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion linéaire correspondant au creusement réalisé pour la pose des fondations d'un mur.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1220&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Tranchée de récupération</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Recovery trench</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Rückgewinnungsgraben</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA31 - Tranchée de récupération</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1220</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die einem Aushub entspricht, der durchgeführt wurde, um zuvor abgelagerte Materialien oder Objekte zurückzugewinnen.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to an excavation made to recover previously deposited materials or objects.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à un creusement réalisé pour récupérer des matériaux ou objets précédemment déposés.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1221&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Trou de poteau</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Posthole</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Pfostenloch</skos:prefLabel>
	<skos:altLabel xml:lang="fr">NA50 - Trou de poteau</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1221</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Erosion, die der Vertiefung entspricht, die ausgegraben wurde, um einen Pfosten oder eine vertikale Stütze einzubetten. Sie ist in der Regel breiter und tiefer als der Pfostenabdruck.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="en">Erosion corresponding to the cavity dug to embed a post or vertical support, typically larger and deeper than the post imprint.&lt;span class=&quot;ql-cursor&quot;&gt;﻿&lt;/span&gt;</skos:definition>
	<skos:definition xml:lang="fr">Érosion correspondant à la cavité creusée pour enchâsser un poteau ou un support vertical. Elle est généralement plus large et plus profonde que l'empreinte de poteau.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1222&amp;idt=th999">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Voie aménagée</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Constructed road</skos:prefLabel>
	<skos:prefLabel xml:lang="de">Befestigte Straße</skos:prefLabel>
	<skos:altLabel xml:lang="fr">PA90 - Voirie construction</skos:altLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1155&amp;idt=th999"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1138&amp;idt=th999"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th999"/>
	<opentheso:memberOf rdf:resource="https://thesaurus.mom.fr/?idg=g108&amp;idt=th999"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-23</dcterms:modified>
	<dcterms:identifier>1222</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="de">Ablagerung, die der konstruierten Oberfläche eines Verkehrsweges entspricht, wie eine Straße, ein Weg oder ein befestigter Boden. Sie kann Schichten aus organisierten Materialien (Steine, Mörtel, gestampfte Erde) umfassen und zeugt von der absichtlichen Gestaltung eines Raumes für den Durchgang und die Zirkulation.</skos:definition>
	<skos:definition xml:lang="en">Deposit corresponding to the constructed surface of a circulation route, such as a street, path, or paved floor. It may include layers of organized materials (stones, mortar, compacted soil) and attests to the intentional arrangement of a space for passage and circulation.</skos:definition>
	<skos:definition xml:lang="fr">Dépôt correspondant à la surface construite d’une voie de circulation, telle qu’une rue, un chemin ou un sol de circulation aménagé. Il peut inclure des couches de matériaux organisés (pierres, mortier, terre battue) et témoigne de l’aménagement intentionnel d’un espace pour le passage et la circulation.</skos:definition>
</rdf:Description>

