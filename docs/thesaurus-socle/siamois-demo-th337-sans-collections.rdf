	<dcterms:identifier>1449</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Matériaux de construction en terre crue : brique crue, torchis, adobe, pisé… Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025, p. 52</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1450&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">[terre crue] autre</skos:prefLabel>
	<skos:prefLabel xml:lang="en">[raw earth] other</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1435&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-TTJCC9M1W7DKTJ4L835HB-G"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1399&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1450</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Tout objet en terre crue qui n’est pas un matériel de construction : statuettes en terre crue, sceaux, indéterminé… Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025, p. 52</skos:definition>
</rdf:Description>

