<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1637&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Coffre funéraire en plomb</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1431&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0396&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1414&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1637</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Contenant solide (plus ou moins mobile, vu le poids et la malléabilité du matériau) du corps du défunt, constitué de feuilles de plomb pliées et soudées. Ce contenant lui-même peut être placé dans un contenant statique en bois, maçonné, en dalles ou monolithe. (Colardelle, Terminologie, 1996) Source(s) : d'après PACTOLS</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2790, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1638&amp;idt=th337">
