	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1299</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Assise basse de pierres ou de maçonnerie établie au niveau du sol pour asseoir une élévation en terre ou une paroi de bois et l'isoler de l'humidité. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 8253, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1300&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Palissade</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1200&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0293&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1183&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
