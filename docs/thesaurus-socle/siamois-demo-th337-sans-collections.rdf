<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1392&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Unité d'enregistrement</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Recording unit</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-TF9H45V00BK9Q9NRRTL0S-1"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1386&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<skos:notation>SIAMOISFIELD#SIAS.recordingUnit</skos:notation>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1392</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">&lt;strong&gt;Mobilier :&lt;/strong&gt; Code d’inventaire de l’UE de provenance comme défini dans la feuille UE.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;VAB :&lt;/strong&gt; Code d’inventaire de l’UE désignant la sépulture d’où provient le squelette ou le lot de restes, défini dans la feuille UE.&lt;/p&gt;&lt;p&gt;Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1393&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
