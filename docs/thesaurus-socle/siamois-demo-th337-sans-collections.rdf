	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-TRM104D4HL2XBX05C2X77-0"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1399&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
