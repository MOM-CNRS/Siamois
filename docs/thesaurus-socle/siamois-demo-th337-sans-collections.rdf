	<dcterms:identifier>1878</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Dernière phase du Néolithique (Néolithique final), marquée par les premières métallurgies du cuivre, d'environ 2900 à 2200 av. J.-C. (dont le Campaniforme). Source : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel).</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1879&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
