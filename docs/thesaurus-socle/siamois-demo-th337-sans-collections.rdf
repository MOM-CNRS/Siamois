	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1729&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0529&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1680&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1816</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Ruban souple revêtu d'une couche magnétisable enregistrant du son, des images ou des données ; la démagnétisation, le collage des spires et la disparition des lecteurs en compromettent la lisibilité à long terme. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 1690, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1817&amp;idt=th337">
