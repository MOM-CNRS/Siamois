	<skos:prefLabel xml:lang="en">Treatment manager</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-TWPL2021GTRXFSWF4HCC6-8"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1640&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
