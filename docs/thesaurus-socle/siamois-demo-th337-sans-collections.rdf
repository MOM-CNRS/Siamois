<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1829&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Type</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Type</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-T7R1QNP660J458HCNBJS6-7"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1828&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1838&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1839&amp;idt=th337"/>
