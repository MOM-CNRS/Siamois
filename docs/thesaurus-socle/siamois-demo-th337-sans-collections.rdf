	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9163, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1618&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
