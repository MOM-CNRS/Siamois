	<skos:prefLabel xml:lang="en">Treatment start</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-TSNNXRXV30GLFG6X8JVTC-0"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1640&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<skos:notation>SIAMOISFIELD#SIAST.treatmentStart</skos:notation>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1646</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Dates (aaaa-mm-jj) du début et de la fin du traitement séparé par le signe &amp;amp; (esperluette). &lt;/p&gt;&lt;p&gt;Cette information est importante pour les traitements de conservation curative, stabilisation… ou pour les études spécialisées comme les analyses C14, ADN… Si le traitement a eu lieu sur une seule journée, indiquer seulement la date du jour.&lt;/p&gt;&lt;p&gt;Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025</skos:definition>
</rdf:Description>

