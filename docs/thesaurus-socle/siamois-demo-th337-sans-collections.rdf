	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1114</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1115&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Habitat ouvert</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0242&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1115</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Habitat dépourvu de toute limite apparente. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9999, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1116&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Habitat enclos</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0243&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1116</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site à vocation surtout domestique, occupé au moins de façon saisonnière ou semi-permanente, entouré d'un talus et d'un fossé, d'une palissade ou d'une autre clôture. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9998, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1117&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Hameau</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0244&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1117</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Forme la plus réduite d'agglomération, réunissant quelques maisons ou fermes sans équipement collectif marqué. Source(s) : d'après Ginouvès et Martin, Dictionnaire méthodique de l'architecture grecque et romaine, 1998</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 4940, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1118&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Village</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0245&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1118</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Groupement de maisons et d'autres bâtiments, en général plus grand qu'un hameau et plus petit qu'une ville, dont l'organisation et l'administration sont plus simples que celles d'une ville. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 10003, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1119&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Ville</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0246&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1119</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Agglomération se distinguant du village par le nombre de ses habitants, par des fonctions commerciales qui débordent son propre peuplement et desservent les villages environnants, et surtout par sa fonction politique de siège du pouvoir. Source(s) : d'après Ginouvès et Martin, Dictionnaire méthodique de l'architecture grecque et romaine, 1998</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9179, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1120&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Oppidum</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0247&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1120</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Terme peu précis désignant les grands habitats de l'âge du Fer aux dimensions de villes. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9988, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1121&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Villa</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0248&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1121</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Établissement rural romain associant une partie résidentielle (pars urbana) et une partie agricole ou artisanale (pars rustica), au centre d'un domaine d'exploitation. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9174, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Réserver à l'établissement rural antique.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1122&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Ferme</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0249&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1122</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Établissement rural regroupant l'habitation de l'exploitant et les bâtiments nécessaires à l'exploitation agricole. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 4346, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1123&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Abri sous roche</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0250&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1123</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Cavité naturelle peu profonde, ouverte sous un surplomb rocheux, dont la paroi peut porter un décor. Source(s) : d'après EwaGlos, European Illustrated Glossary of Conservation Terms for Wall Paintings and Architectural Surfaces, 2015</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9564, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1124&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Grotte</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0251&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1124</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Cavité souterraine naturelle ouverte sur l'extérieur, développée notamment dans les roches solubles. Source(s) : d'après PACTOLS</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 4879, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Employer pour la cavité elle-même ; pour l'occupation qui s'y installe, employer les termes d'habitat en cavité.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1125&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Site de plein air</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0252&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1125</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site d'occupation paléolithique ou mésolithique établi hors des grottes et des abris sous roche, reconnu notamment à des traces de foyers ou d'autres aménagements. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9943, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1126&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Campement</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0253&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1126</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site d'occupation temporaire ou saisonnière, caractérisé par des aménagements légers et des structures peu pérennes (foyers, calages, abris). Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2218, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Nomme ce à quoi l'objet sert. Facette d'indexation croisée : combiner avec un type d'objet de la branche 11 et une matière de la branche 4.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1127&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Nécropole</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0254&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1127</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Espace funéraire de grande étendue, groupant de nombreuses sépultures et employé sur une longue durée. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 6173, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Emploi traditionnellement réservé aux grands ensembles funéraires antiques ou antérieurs à la christianisation, par opposition à « cimetière ». La distinction étant contestée dans la littérature funéraire, fixer et documenter le critère retenu (chronologie, étendue, confession) avant indexation.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1128&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Cimetière</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0255&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1128</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Espace délimité et durablement affecté au dépôt des morts d'une communauté, organisé en sépultures individualisées et parfois associé à un édifice de culte. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2670, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Voir « nécropole », dont la distinction avec ce libellé repose sur des critères variables selon les traditions d'enregistrement (chronologie, confession, étendue) : fixer le critère retenu au niveau local.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1129&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Champ d'urnes</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0256&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1129</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Nécropole de l'âge du Bronze où de nombreuses urnes cinéraires ont été enfouies. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9892, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1130&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Tumulus</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0257&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1130</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Tertre de terre et de pierres, de plan circulaire ou allongé, élevé au-dessus d'une ou de plusieurs sépultures. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 8986, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Pour une masse exclusivement constituée de pierres sèches recouvrant des chambres mégalithiques, employer « cairn ».</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1131&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Dolmen</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0258&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1131</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Monument mégalithique formé d'une ou plusieurs dalles horizontales posées sur des supports verticaux, délimitant une chambre funéraire à l'origine généralement incluse dans un cairn ou un tertre ; attesté au Néolithique. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 3592, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1132&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Menhir</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0259&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1132</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Pierre ou bloc dressé intentionnellement dans le sol ; le terme s'applique à une pierre isolée. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9911, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1133&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Sanctuaire</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0260&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1133</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Espace consacré à une ou plusieurs divinités, parfois réduit à un bois sacré, le plus souvent pourvu d'un autel et d'un temple ainsi que des constructions nécessaires à l'exercice du culte. Source(s) : d'après Ginouvès et Martin, Dictionnaire méthodique de l'architecture grecque et romaine, 1998</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 8032, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1134&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Église</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0261&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1134</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Édifice affecté au culte chrétien et à l'assemblée des fidèles, ordonné autour d'un espace de célébration réservé au clergé. Source(s) : d'après Pérouse de Montclos, 1972</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 3763, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1135&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Monastère</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0262&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1135</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Ensemble de bâtiments où vit une communauté de religieux ou de religieuses soumise à une règle. Source(s) : d'après F. Leroy, Terminologie de l'architecture et de la sculpture romanes, 2007</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9343, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1136&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Enceinte</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0263&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1136</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Clôture continue enveloppant un espace ou une agglomération pour le délimiter et en défendre l'accès. Source(s) : d'après PACTOLS</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 3886, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Employer pour le circuit délimité ; pour l'ouvrage massif qui le matérialise, employer « rempart », et pour un segment entre deux tours, « courtine ».</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1137&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Enclos</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0264&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1137</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Espace délimité par une clôture, éventuellement doublée ou remplacée par un fossé, sur tout ou partie de son pourtour. Source(s) : d'après PACTOLS</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 3895, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1138&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Éperon barré</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0265&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1138</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site fortifié occupant un promontoire naturellement défendu sur la majeure partie de son pourtour, isolé du plateau par un ouvrage transversal barrant son accès. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 4015, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1139&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Château fort</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0266&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1139</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Résidence seigneuriale fortifiée médiévale, associant fonctions résidentielles, de commandement et de défense au sein d'une ou de plusieurs enceintes. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2567, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1140&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Camp militaire</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0267&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1140</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Espace aménagé, souvent délimité par un ouvrage défensif, destiné au stationnement temporaire ou durable d'une troupe. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2213, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1141&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Parcellaire</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0268&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1141</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Ensemble de champs qui semblent former un tout cohérent. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 10021, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1142&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Voie</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0269&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1142</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Tracé aménagé pour la circulation, par terre ou par eau ; les tracés terrestres se répartissent en routes, chemins et sentiers. Source(s) : d'après Ginouvès et Martin, Dictionnaire méthodique de l'architecture grecque et romaine, 1998</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 9192, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Employer comme terme générique ; préférer « route », « chemin » ou « sentier » lorsque le statut de la voie est établi.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1143&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Carrière</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0270&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1143</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site d'extraction, à ciel ouvert ou souterrain, d'où sont tirés les matériaux pierreux destinés à la construction. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2300, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1144&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Minière de silex</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0271&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1144</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site où les bancs de silex de la craie ont été exploités par des puits verticaux profonds, d'où rayonnent souvent des galeries horizontales. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 10038, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1145&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Atelier</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0272&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1145</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Lieu consacré à la fabrication. Source(s) : d'après PACTOLS</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 1522, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Terme générique : préférer le terme spécifique lorsque la production est identifiée (forge, plâtrerie, tannerie, teinturerie…).</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1146&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Atelier de taille</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0273&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1146</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site livrant les traces d'un travail de la pierre sur place pour fabriquer outils, armes ou autres objets, le plus souvent préhistorique. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 10039, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1147&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Saline</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0274&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1147</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Site où l'on obtient le sel en faisant bouillir et évaporer de la saumure ou de l'eau de mer dans de grands bacs ; souvent, seuls subsistent les amas formés par les déchets de production. Source(s) : d'après FISH Monument Type Thesaurus (Historic England)</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 10036, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1148&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Moulin</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0275&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1148</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Bâtiment équipé d'une machine à moudre comportant une ou plusieurs meules. Source(s) : d'après PACTOLS</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 6061, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1149&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Thermes</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0276&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1149</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Établissement de bains collectifs du monde romain, organisant un parcours de salles à températures graduées et de bassins, chauffé par hypocauste. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 8667, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Pour un ensemble balnéaire domestique, employer « bains privés ».</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1150&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Aqueduc</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0277&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1150</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Ouvrage d'adduction conduisant l'eau par gravité d'un point de captage vers un lieu de consommation, associant selon le relief conduits enterrés, tranchées couvertes, siphons et ponts. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 1307, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Employer pour le tracé et le dispositif d'ensemble ; pour la seule section franchissant une dépression sur arcades, employer « pont-aqueduc ».</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1151&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Port</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0278&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1151</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Ensemble d'aménagements établis sur un plan d'eau abrité, associant ouvrages de protection, d'accostage et de manutention pour l'abri, le chargement et l'entretien des bâtiments. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 7264, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1152&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Épave</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1041&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1042&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1043&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0279&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1024&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
