	<dcterms:identifier>1452</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Matériaux de construction en terre cuite : brique, tuile, carreau, canalisation, brique de colonne… Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025, p. 52</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1453&amp;idt=th337">
