<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1486&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Perle</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Bead</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1428&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0331&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1400&amp;idt=th337"/>
