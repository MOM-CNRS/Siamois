<rdf:Description rdf:about="https://thesaurus.mom.fr/api/ark:/66666/th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
	<skos:prefLabel xml:lang="fr">Siamois DEMO</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Siamois DEMO</skos:prefLabel>
	<skos:hasTopConcept rdf:resource="https://thesaurus.mom.fr/?idc=1000&amp;idt=th337"/>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<dcterms:contributor>gregory.bliault</dcterms:contributor>
	<dcterms:title>Siamois DEMO</dcterms:title>
	<dcterms:description xml:lang="fr">Champs du socle commun SIAMOIS et listes de vocabulaire de démonstration, alignés sur le référentiel national relatif au rapport d'opération d'archéologie préventive.</dcterms:description>
	<dcterms:language>fr</dcterms:language>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1000&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Siamois - Concepts système</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Siamois - System concepts</skos:prefLabel>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1001&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1153&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1171&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1357&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1386&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1640&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1677&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1828&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1853&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1906&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1920&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<skos:topConceptOf rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<skos:notation>SIAMOIS#SIAAUTO</skos:notation>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1000</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Champs du socle commun SIAMOIS : une table par entité, un concept par champ, et pour les champs à vocabulaire la liste de valeurs proposée en démonstration. Une liste qui dépend du type est portée par des liens « associé » entre le type et les valeurs qu'il autorise.</skos:definition>
	<skos:definition xml:lang="en">Fields of the SIAMOIS common core: one table per entity, one concept per field, and for vocabulary fields the demonstration list of values. A list that depends on the type is carried by 'related' links between the type and the values it allows.</skos:definition>
</rdf:Description>

