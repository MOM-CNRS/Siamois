	<dcterms:identifier>1830</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">&lt;strong&gt;Mobilier :&lt;/strong&gt; Identifiant du contenant dans lequel se trouve l’objet ou le lot au moment du versement à l’État comme défini dans l’inventaire des contenants. Cet identifiant doit être unique dans l’opération tous types de vestiges confondus.&lt;/p&gt;&lt;p&gt;Pour les lots répartis dans plusieurs contenants, lister ici tous les contenants concernés en les séparant par le signe &amp;amp; (esperluette).&lt;/p&gt;&lt;p&gt;&lt;strong&gt;VAB :&lt;/strong&gt; Identifiant du contenant dans lequel se trouve le squelette ou le lot de restes au moment du versement à l’État comme défini dans l’inventaire des contenants.&lt;/p&gt;&lt;p&gt;Cet identifiant doit être unique dans l’opération tous types de vestiges confondus.&lt;/p&gt;&lt;p&gt;Pour les lots de restes répartis dans plusieurs contenants, lister ici tous les contenants concernés en les séparant par le signe &amp;amp; (esperluette).&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Prélèvement :&lt;/strong&gt; Identifiant du ou des contenants dans le(s)quel(s) est stocké le prélèvement comme défini dans l’inventaire des contenants.&lt;/p&gt;&lt;p&gt;S’il y a plusieurs contenants, séparer les numéros par le signe &amp;amp; (esperluette).&lt;/p&gt;&lt;p&gt;Ce(s) numéro(s) doi(ven)t être unique(s) dans l’opération tous types de vestiges confondus.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Documentation :&lt;/strong&gt; Identifiant du contenant dans lequel se trouve le document, le lot ou le dossier numérique comme défini dans l’inventaire des contenants ou code DOI22 si le document numérique a été déposé sur un serveur accessible en ligne. &lt;/p&gt;&lt;p&gt;Ce numéro doit être unique dans l’opération.&lt;/p&gt;&lt;p&gt;Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1831&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Lieu</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Place</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-T83CJV49CLXD6R6VCMN7X-H"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1828&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<skos:notation>SIAMOISFIELD#SIAC.spatialUnit</skos:notation>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1831</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">&lt;strong&gt;Mobilier :&lt;/strong&gt; Indication du lieu de conservation de l’objet ou du lot s’il n’est pas physiquement remis à l’État à la suite du rendu du rapport et du versement des données scientifiques de l'archéologie.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;VAB : &lt;/strong&gt;Indication du lieu de conservation du squelette ou du lot de restes s’il n’est pas physiquement remis à l’État à la suite du rendu du rapport et du versement des données scientifiques de l'archéologie.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Prélèvement :&lt;/strong&gt; Indication du lieu de conservation si le prélèvement n’est pas physiquement remis à l’État à la suite du rendu du rapport et du versement des données scientifiques de l'archéologie.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Documentation :&lt;/strong&gt; Pour les tirages et empreintes uniquement, indication du lieu de conservation s’ils ne sont pas physiquement remis à l’État à la suite du rendu du rapport et du versement des données scientifiques de l'archéologie.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025</skos:definition>
</rdf:Description>

