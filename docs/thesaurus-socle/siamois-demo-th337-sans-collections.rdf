	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1728&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1729&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0528&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1680&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1815</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Image photographique inversée portée par une plaque de verre, obtenue au collodion humide puis au gélatino-bromure d'argent ; se conserve à plat ou de chant, à l'abri des chocs et des variations climatiques. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 6180, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1816&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Bande magnétique</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1723&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1724&amp;idt=th337"/>
