	<skos:prefLabel xml:lang="en">Report code</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-T890FPJ23FGVMV3T963M0-G"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1640&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<skos:notation>SIAMOISFIELD#SIAST.reportCode</skos:notation>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1645</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Code d’inventaire qui est donné, dans la feuille &quot;documentation&quot;, au rapport lié au traitement effectué : étude spécialisée, datation, rapport conservation curative… Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025</skos:definition>
	<skos:editorialNote xml:lang="fr">Héritage d'une autre feuille.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1646&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
