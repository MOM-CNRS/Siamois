	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1509</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Isolement de chaque objet dans son propre contenant. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2916, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1510&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Conditionnement en lot</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0453&amp;idt=th326"/>
