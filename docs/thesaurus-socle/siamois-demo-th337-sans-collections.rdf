	<dcterms:identifier>1022</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">La nature et les références de l'opération : numéro et date (aaaa-mm-jj) de l'arrêté de prescription d’opération archéologique dans le système national d'information du ministère de la Culture, et, le cas échéant, de l'acte administratif de désignation du responsable scientifique de l’opération préventive. Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025, p. 8</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1023&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Chronologie</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Chronology</skos:prefLabel>
