	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1400</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Identification, et au besoin, description, de l’objet ou du lot en fonction des usages du responsable scientifique de l’opération et de l’avancement des études.&lt;/p&gt;&lt;p&gt;Exemples de déterminations possibles : faune, bovin / terre cuite, céramique / céramique commune / céramique fine / assiette type 3b, céramique fine à pâte grise lissée fumigée complète / lot de fragments de lèvre d’amphore Dressel 1 dont un est estampillé EFD / lissoir sur fragment de côte ocré, aurignacien / fragment de lame retouché / clous / quincaille tôle / parure fibule fragment / lot de clous et rivets à tête convexe / culinaire fourchette à chaudron / pollen de bouleau / …&lt;/p&gt;&lt;p&gt;Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025</skos:definition>
	<skos:editorialNote xml:lang="fr">Pactols (TG) + autres thésaurus (TS), th56, Artefacts, etc.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1401&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Nature du prélèvement</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Sampling nature</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1432&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-TSR0279XMMN9RX4T714DM-H"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1386&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1497&amp;idt=th337"/>
