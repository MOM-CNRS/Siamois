	<skos:scopeNote xml:lang="fr">Méthode de référence en palynologie et en micromorphologie.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1534&amp;idt=th337">
