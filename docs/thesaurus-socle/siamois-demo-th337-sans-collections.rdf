	<dcterms:creator>gregory.bliault</dcterms:creator>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1378&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Relation vers une unité synchrone</skos:prefLabel>
	<skos:prefLabel xml:lang="en">Relation to a contemporary unit</skos:prefLabel>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1357&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1379&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1380&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1381&amp;idt=th337"/>
	<skos:narrower rdf:resource="https://thesaurus.mom.fr/?idc=1385&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<skos:notation>SIAMOIS#SIARU.STRATI.SYNCHRONOUS</skos:notation>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1378</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Relations stratigraphiques (fiche liée + type de relation). Code de champ : SIARU.STRATI.SYNCHRONOUS. Relation symétrique : la fiche est son propre miroir.</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1379&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">équivalent à</skos:prefLabel>
	<skos:prefLabel xml:lang="en">equivalent to</skos:prefLabel>
	<skos:altLabel xml:lang="fr">équivalent</skos:altLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0223&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1378&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1379</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Relation stratigraphique : les deux UE, enregistrées séparément, correspondent à une même action ou un même dépôt. Source : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel).</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1380&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">contemporain de</skos:prefLabel>
	<skos:prefLabel xml:lang="en">contemporary with</skos:prefLabel>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1378&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1380</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1381&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">se lie à</skos:prefLabel>
	<skos:prefLabel xml:lang="en">bonded with</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0500&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1378&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1381</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Qualifie deux maçonneries dont les matériaux s'engagent l'un dans l'autre à leur rencontre, formant une construction solidaire. Source(s) : d'après Ginouvès et Martin, Dictionnaire méthodique de l'architecture grecque et romaine, 1992</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 5437, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Opposer à la rencontre de murs simplement juxtaposés, marquée par une ligne de séparation.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1382&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Adossé</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0499&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1358&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
	<dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:created>
	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1382</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Se dit d'un élément solidaire d'un mur ou d'un support vertical par un de ses côtés, plus particulièrement par un de ses grands côtés. Fontaine adossée, colonne adossée, cheminée adossée, autel adossé à un pilier. Source(s) : d'après Bibracte, th256 ; Pérouse de Montclos, 1972</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 985, pour l'instance de test.</skos:editorialNote>
	<skos:scopeNote xml:lang="fr">Décrit la position d'un élément par rapport à un autre et le mode de raccord entre ouvrages.</skos:scopeNote>
</rdf:Description>

