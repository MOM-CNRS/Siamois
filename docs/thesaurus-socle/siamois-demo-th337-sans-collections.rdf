	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1445</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Tout élément organique indéterminable. Source : Référentiel national relatif au rapport d'opération d'archéologie préventive, ministère de la Culture, 13 octobre 2025, p. 52</skos:definition>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1446&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">[minéral] lithique</skos:prefLabel>
	<skos:prefLabel xml:lang="en">[mineral] lithic</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1427&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1434&amp;idt=th337"/>
