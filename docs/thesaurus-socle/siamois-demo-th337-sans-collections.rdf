	<dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-27</dcterms:modified>
	<dcterms:identifier>1330</dcterms:identifier>
	<dcterms:creator>gregory.bliault</dcterms:creator>
	<skos:definition xml:lang="fr">Période des premières sociétés agro-pastorales et sédentaires, d'environ 5700 à 2200 av. J.-C. en France ; dans cette liste, elle inclut le Chalcolithique. Source : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel).</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1331&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Néolithique ancien</skos:prefLabel>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/66666/SIA-TN9P6PMRG5J1WMXQ2GNN3-J"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1330&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
