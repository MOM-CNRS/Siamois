</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1377&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">est comblée par</skos:prefLabel>
