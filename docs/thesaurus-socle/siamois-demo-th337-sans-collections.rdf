	<skos:definition xml:lang="fr">Conduit de faible section, à ciel ouvert ou couvert de dalles, aménagé au bord d'une voie ou d'un sol pour collecter et évacuer les eaux de ruissellement. Source(s) : SIAMOIS 2026</skos:definition>
	<skos:editorialNote xml:lang="fr">SIAMOIS 2026 (non reprise du référentiel). Terme repris du Réservoir_SIAMOIS (th329), identifiant interne 2231, pour l'instance de test.</skos:editorialNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1302&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Drain</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1200&amp;idt=th337"/>
	<skos:exactMatch rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/?idc=rn0309&amp;idt=th326"/>
	<skos:broader rdf:resource="https://thesaurus.mom.fr/?idc=1183&amp;idt=th337"/>
	<skos:inScheme rdf:resource="https://thesaurus.mom.fr/api/ark:/66666/th337"/>
