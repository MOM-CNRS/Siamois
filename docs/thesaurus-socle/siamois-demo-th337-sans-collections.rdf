<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1815&amp;idt=th337">
	<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
	<skos:prefLabel xml:lang="fr">Négatif sur verre</skos:prefLabel>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1723&amp;idt=th337"/>
	<skos:related rdf:resource="https://thesaurus.mom.fr/?idc=1724&amp;idt=th337"/>
