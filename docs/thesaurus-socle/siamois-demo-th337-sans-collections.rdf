	<skos:scopeNote xml:lang="fr">Employer pour la micromorphologie et pour la fouille en laboratoire d'ensembles fragiles.</skos:scopeNote>
</rdf:Description>

<rdf:Description rdf:about="https://thesaurus.mom.fr/?idc=1533&amp;idt=th337">
